meta {
  name: Update Goal
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/goal/{{goalId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "goalType": "fitness",
    "goalName": "Run a 5K - Updated",
    "generalObjective": "Complete a 5K run — updated goal description",
    "stake": 20,
    "deadline": "2027-07-01T00:00:00.000Z",
    "milestones": [
      {
        "milestoneName": "Halfway Check-In",
        "type": "fitness",
        "milestoneDeadline": "2027-04-01T00:00:00.000Z"
      },
      {
        "milestoneName": "Final Run",
        "type": "fitness",
        "milestoneDeadline": "2027-07-01T00:00:00.000Z"
      }
    ],
    "allOrNothing": false
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("milestoneId", res.body.milestones[0].milestoneId);
  }
}
